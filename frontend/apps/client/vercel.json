{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://yira.onrender.com/api/$1"
    },
    {
      "source": "/_allauth/(.*)",
      "destination": "https://yira.onrender.com/_allauth/$1"
    },
    {
      "source": "/accounts/(.*)",
      "destination": "https://yira.onrender.com/accounts/$1"
    },
    {
      "source": "/admin/(.*)",
      "destination": "https://yira.onrender.com/admin/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
