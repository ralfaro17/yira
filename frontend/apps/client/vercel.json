{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://taguer.onrender.com/api/:path*"
    },
    {
      "source": "/_allauth/:path*",
      "destination": "https://taguer.onrender.com/_allauth/:path*"
    },
    {
      "source": "/accounts/:path*",
      "destination": "https://taguer.onrender.com/accounts/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://taguer.onrender.com/admin/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
