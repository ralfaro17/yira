{
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://yira.onrender.com/api/$1" },
    { "source": "/_allauth/(.*)", "destination": "https://yira.onrender.com/_allauth/$1" },
    { "source": "/admin/(.*)", "destination": "https://yira.onrender.com/admin/$1" },
    { "source": "/((?!\\.well-known/).*)", "destination": "/index.html" }
  ]
}
